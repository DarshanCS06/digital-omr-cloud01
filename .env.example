# Digital OMR Cloud - Environment Configuration
PROJECT_NAME="Digital OMR Cloud"
ENVIRONMENT="development"
DEBUG=true

# Database (Default local SQLite for instant zero-dependency testing, or PostgreSQL for production)
# PostgreSQL example: postgresql+psycopg2://postgres:postgres@localhost:5432/omr_cloud
DATABASE_URL="sqlite:///./omr.db"

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY="insecure_default_secret_key_please_change_in_production_32bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Task Queue (Redis for RQ/Celery, synchronous fallback when offline)
REDIS_URL="redis://localhost:6379/0"

# Storage Configuration
# STORAGE_BACKEND: 'local' for local disk or 's3' for AWS S3 / MinIO / Cloudflare R2
STORAGE_BACKEND="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT_URL=""
S3_BUCKET_NAME=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"

# Upload and Security Safeguards
MAX_UPLOAD_SIZE_BYTES=15728640
MAX_BATCH_FILES=500
ALLOWED_EXTENSIONS=["jpg","jpeg","png","webp"]

# CORS Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Initial Administrator Credentials (used for initial bootstrap script)
INITIAL_ADMIN_EMAIL="admin@digitalomr.edu"
INITIAL_ADMIN_PASSWORD="AdminSecurePassword123!"
INITIAL_ADMIN_NAME="System Administrator"
